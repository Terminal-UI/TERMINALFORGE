#!/usr/bin/env bash
set -euo pipefail

SCRIPT_PATH="${BASH_SOURCE[0]}"
while [ -L "$SCRIPT_PATH" ]; do
  SCRIPT_DIR="$(cd -P "$(dirname "$SCRIPT_PATH")" && pwd)"
  SCRIPT_PATH="$(readlink "$SCRIPT_PATH")"
  [[ "$SCRIPT_PATH" != /* ]] && SCRIPT_PATH="$SCRIPT_DIR/$SCRIPT_PATH"
done

ROOT_DIR="$(cd -P "$(dirname "$SCRIPT_PATH")/.." && pwd)"
VENV_DIR="$ROOT_DIR/terminalforge/.venv"

if [[ ! -x "$VENV_DIR/bin/python" ]]; then
  echo "Virtual environment not found at $VENV_DIR" >&2
  echo "Create it with:" >&2
  echo "  cd $ROOT_DIR/terminalforge && python3 -m venv .venv" >&2
  echo "  source .venv/bin/activate && pip install -e '.[dev]'" >&2
  exit 1
fi

exec "$VENV_DIR/bin/python" -m terminalforge.cli "$@"
